NODE_ENV=production
PORT=10000
PUBLIC_BASE_URL=https://YOUR-RENDER-URL.onrender.com
TWILIO_TEST_MODE=true
# Twilio account auth token, from console.twilio.com. When set, every inbound
# /twilio/voice* request must carry a valid X-Twilio-Signature or it is rejected
# with 403. When unset the gateway logs a warning and accepts requests, so local
# runs and the test IVR keep working — set this in production.
# Signatures are checked against PUBLIC_BASE_URL when it is set, so that value
# must match the webhook URL configured on the Twilio number exactly.
TWILIO_AUTH_TOKEN=
TWILIO_MANAGER_PHONE=+15717495444
TWILIO_CALLER_ID=
TWILIO_VIETNAMESE_LANGUAGE=vi-VN
# Origins for the two Lantern House entities. Falls Church (the pilot site) is
# lanternhousebistro.com — owner-confirmed 2026-08-01. lanternhousevietbistro.com is kept
# as a legacy alias; drop it once the owner confirms it is no longer pointed anywhere.
# lanternhousekitchenbar.com belongs to the separate Reston entity — leave it in place.
# Note: nothing in server.js reads this yet; it is documentation until CORS is implemented.
ALLOWED_ORIGINS=https://lanternhousebistro.com,https://www.lanternhousebistro.com,https://lanternhousevietbistro.com,https://www.lanternhousevietbistro.com,https://www.lanternhousekitchenbar.com

# Vapi conversational AI.
# When VAPI_API_KEY and VAPI_ASSISTANT_ID are both set, /twilio/voice hands the call
# to the Vapi assistant. If either is missing the gateway serves the test-mode IVR
# (language + location selection + manager transfer) instead, so calls never drop.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Vapi's Twilio media-stream endpoint. Override only if Vapi changes it.
VAPI_STREAM_URL=wss://api.vapi.ai/twilio/inbound_call
# Kill switch: set to false to force the test-mode IVR without removing the keys.
VAPI_ENABLED=true
