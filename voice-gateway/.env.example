NODE_ENV=production
PORT=10000
PUBLIC_BASE_URL=https://YOUR-RENDER-URL.onrender.com
TWILIO_TEST_MODE=true
TWILIO_MANAGER_PHONE=+15717495444
TWILIO_CALLER_ID=
TWILIO_VIETNAMESE_LANGUAGE=vi-VN
ALLOWED_ORIGINS=https://lanternhousevietbistro.com,https://www.lanternhousevietbistro.com,https://www.lanternhousekitchenbar.com

# Vapi conversational AI.
# When VAPI_API_KEY and VAPI_ASSISTANT_ID are both set, /twilio/voice hands the call
# to the Vapi assistant. If either is missing the gateway serves the test-mode IVR
# (language + location selection + manager transfer) instead, so calls never drop.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Vapi's Twilio media-stream endpoint. Override only if Vapi changes it.
VAPI_STREAM_URL=wss://api.vapi.ai/twilio/inbound_call
# Kill switch: set to false to force the test-mode IVR without removing the keys.
VAPI_ENABLED=true
