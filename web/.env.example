# Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice AI
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
# Returned to Vapi on assistant-request so it knows which assistant to run.
VAPI_ASSISTANT_ID=
# Optional but strongly recommended: set the same value as the assistant's
# server-URL secret in Vapi. When set, the webhook rejects unsigned requests.
VAPI_WEBHOOK_SECRET=
OPENAI_API_KEY=

# Twilio (SMS + calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Pilot tenant
# UUID of the businesses row for this pilot. Used to scope caller lookups when
# Vapi does not supply call.metadata.business_id. Without it, every caller is
# treated as anonymous and no calls are logged.
DEFAULT_BUSINESS_ID=
BUSINESS_NAME=Lantern House Vietnamese Restaurant

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
